{
  "name": "fastfeet-api",
  "version": "0.0.1",
  "description": "",
  "author": "wander-alves",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "services:up": "docker compose -f ./infra/docker-compose.yaml up -d",
    "services:down": "docker compose -f ./infra/docker-compose.yaml down  ",
    "migrate:up": "prisma migrate dev",
    "migrate:down": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "test": "vitest run --config ./tests/setup/vitest.config.mts",
    "test:watch": "vitest --config ./tests/setup/vitest.config.mts",
    "test:cov": "vitest --coverage",
    "test:e2e": "vitest run --config ./tests/setup/vitest.config.e2e.mts",
    "test:e2e:watch": "vitest --config ./tests/setup/vitest.config.e2e.mts"
  },
  "dependencies": {
    "@nestjs/common": "11.0.1",
    "@nestjs/core": "11.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.0.1",
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "7.2.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@nestjs/cli": "11.0.0",
    "@nestjs/config": "4.0.4",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.1",
    "@types/express": "5.0.0",
    "@types/node": "22.19.17",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.2",
    "globals": "16.0.0",
    "prisma": "7.2.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "unplugin-swc": "1.5.9",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.5"
  }
}
